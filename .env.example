DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
PORT=8000
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LOG_LEVEL=INFO
RECOVER_EXPIRED_RUNS=true
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
# Server-only identity deletion configuration; never expose the service key to mobile.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Configure a private Supabase Storage bucket before replacing LOCAL_ASSET_ROOT.
SUPABASE_STORAGE_BUCKET=mobileadmaker-private
# Mirror original + verified uploads into private storage before completion.
# Worker/output cloud integration is still required before removing shared local storage.
PUBLISH_PRIVATE_UPLOADS=false
# Require verified private output publication before settling a generation.
PUBLISH_PRIVATE_OUTPUTS=false
GEMINI_API_KEY=
ENABLE_REAL_VEO=false
# New jobs may opt into durable product/style planning before media generation.
# Uses MEDIA_REVIEW_MODEL and the shared review spend/concurrency budget; allow one extra call per run.
# Existing jobs retain their saved choice. No extra customer debit is added.
ENABLE_STRUCTURED_PLANNING=false
# Dedicated photo worker: python -m admaker.photo_worker (also requires real media review).
# Keep disabled until external model/pricing acceptance; never use the commands queue.
ENABLE_REAL_PHOTO=false
# PHOTO_QUEUE=photo_commands
# PHOTO_ESTIMATED_COST_MICROUSD=
# Separate photo cost/concurrency caps; no video budget is consumed by a photo attempt.
# PHOTO_DAILY_BUDGET_MICROUSD=
# PHOTO_MAX_CONCURRENT_OPERATIONS=3
# Global open paid operations; uncertain submissions retain their slot after deletion.
# Real-provider execution defaults to 3; also requires VEO_DAILY_BUDGET_MICROUSD.
VEO_MAX_CONCURRENT_OPERATIONS=3
# Enables the local fixture Create flow; these are test credits, not live prices.
ENABLE_LOCAL_FIXTURE_UI=false
VEO_MODEL=veo-3.1-fast-generate-preview
REVENUECAT_CREDIT_PACKS={"com.example.mobileadmaker.credits10":10}
REVENUECAT_ENVIRONMENT=SANDBOX
REVENUECAT_APP_ID=
# Authenticated API requests per account across all API processes (1..10000).
API_REQUESTS_PER_MINUTE=240

# Media review stays disabled until worker/disclosure/acceptance integration is complete.
ENABLE_REAL_MEDIA_REVIEW=false
# Required when explicitly enabling: server-chosen model estimate, UTC daily cap, run call cap.
# MEDIA_REVIEW_ESTIMATE_MICROUSD=
# MEDIA_REVIEW_DAILY_BUDGET_MICROUSD=
# MEDIA_REVIEW_MAX_CALLS_PER_RUN=4
# Required real-review concurrency cap; unconfirmed calls keep a slot until verified terminal.
# MEDIA_REVIEW_MAX_CONCURRENT_CALLS=3

# Explicit provider worker: python -m admaker.provider_worker [--once]
# CAMPAIGN_PACK_QUEUE is shared by campaign packs and explicitly enabled standalone videos.
# It must differ from commands and PHOTO_QUEUE; create it before enabling admission.
# CAMPAIGN_PACK_QUEUE=video_commands
# Requires both real-service flags, all budgets, migrations, FFmpeg and the dedicated campaign queue.
# MEDIA_REVIEW_MODEL=
# VEO_ESTIMATED_COST_MICROUSD=
# GOOGLE_API_KEY, if present, must match GEMINI_API_KEY for this worker.

# Maximum distinct jobs with held credit reservations per account (1..100).
MAX_OUTSTANDING_JOBS_PER_ACCOUNT=10

# Notification transport is opt-in, separate from in-app collection.
# Configure real Expo/APNs/FCM credentials before enabling; never expose this token in mobile env.
ENABLE_ENGAGEMENT_PUSH=false
EXPO_ACCESS_TOKEN=
